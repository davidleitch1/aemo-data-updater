# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
ENV/
env/

# Loose scratch tests at the repo root only. The tests/ directory is tracked --
# a bare test_*.py rule silently swallowed every file added there, and git add
# reported success while committing nothing.
/test_*.py

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Project specific
*.log
logs/
.env
*.tmp
*.pkl
debug_*.py
*_old.py

# Data files (should not be in git)
*.parquet
data/
# Backups, env artifacts, transient logs, archives
*.bak*
.env-e
.env.bak
backfill_log.txt
*.zip
# ...except the recorded nemweb fixtures that keep the collector tests offline
# and deterministic. Public AEMO data, ~77 KB.
!tests/fixtures/**/*.zip
